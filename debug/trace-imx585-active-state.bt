#!/usr/bin/env bpftrace
/*
 * trace-imx585-active-state.bt
 *
 * Focused trace for the Tegra VI crash while binding the imx585 sensor.
 * Relies only on globally visible helpers so it works even when the
 * imx585 module isn't compiled with tracing symbols.
 */

BEGIN
{
    printf("Tracing imx585 focussed paths… ctrl-C to stop\n");
    @tracked_state = 0;
    @init_state = 0;
}

/* Track subdev state allocations to map subdev -> state pointer. */
kprobe:videodev:__v4l2_subdev_state_alloc
{
    @state_alloc_sd[tid] = arg0;
}

kretprobe:videodev:__v4l2_subdev_state_alloc
{
    $sd = @state_alloc_sd[tid];
    delete(@state_alloc_sd[tid]);

    if ($sd && retval) {
        @state_by_sd[(int64)$sd] = (int64)retval;
        printf("__v4l2_subdev_state_alloc: sd=%p state=%p\n", $sd, retval);
    } else {
        printf("__v4l2_subdev_state_alloc: sd=%p state=%p\n", $sd, retval);
    }
}

/* Remember which subdev completed init_finalize so we can seed @init_state. */
kprobe:videodev:v4l2_subdev_init_finalize
{
    @finalize_sd[tid] = arg0;
}

kretprobe:videodev:v4l2_subdev_init_finalize
{
    $sd = @finalize_sd[tid];
    delete(@finalize_sd[tid]);

    if ($sd) {
        $state = @state_by_sd[(int64)$sd];
        if ($state) {
            @init_state = $state;
            printf("v4l2_subdev_init_finalize exit: sd=%p active_state=%p\n",
                   $sd, (void *)$state);
        } else {
            printf("v4l2_subdev_init_finalize exit: sd=%p active_state=None\n", $sd);
        }
    }
}

/* Core helper where the crash happens. */
kprobe:__v4l2_subdev_state_get_format
{
    @entry_get_format[tid] = arg0;

    if (arg0 == 0) {
        printf("__v4l2_subdev_state_get_format(state=NULL pad=%lu stream=%lu)\n",
               arg1, arg2);
        printf("  caller stack:\n%s\n", kstack());
        return;
    }

    if (!@tracked_state && @init_state) {
        @tracked_state = @init_state;
        printf("tracking subdev state via init finalize=%p\n", (void *)@tracked_state);
    }

    if (!@tracked_state) {
        @tracked_state = (int64)arg0;
        printf("tracking subdev state=%p pad=%lu stream=%lu\n", arg0, arg1, arg2);
    }

    if (@tracked_state == (int64)arg0) {
        printf("__v4l2_subdev_state_get_format(entry): state=%p pad=%lu stream=%lu\n",
               arg0, arg1, arg2);
    }
}

kretprobe:__v4l2_subdev_state_get_format
{
    $state = @entry_get_format[tid];
    delete(@entry_get_format[tid]);

    if ($state == 0) {
        printf("__v4l2_subdev_state_get_format(exit): state=NULL fmt=%p\n", retval);
    } else if (@tracked_state && (int64)$state == @tracked_state) {
        printf("__v4l2_subdev_state_get_format(exit): state=%p fmt=%p\n",
               $state, retval);
    }
}

/* Tegra VI glue to show when it pokes the sensor. */
kprobe:tegra_channel_init_subdevices
{
    printf("tegra_channel_init_subdevices(chan=%p)\n", arg0);
}

kretprobe:tegra_channel_init_subdevices
{
    printf("tegra_channel_init_subdevices -> %d\n", retval);
}

kprobe:tegra_camera:tegra_channel_fmts_bitmap_init
{
    printf("tegra_channel_fmts_bitmap_init entry: chan=%p tracked_state=%p init_state=%p\n",
           arg0, (void *)@tracked_state, (void *)@init_state);
    printf("  caller stack:\n%s\n", kstack());
}

kretprobe:tegra_camera:tegra_channel_fmts_bitmap_init
{
    printf("tegra_channel_fmts_bitmap_init -> %d\n", retval);
}
